# Neon Postgres connection string
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Telegram bot username without @ (used for share links)
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=Brewfriends_bot

# Mini App short name from BotFather; leave empty if it is the bot's main Mini App
NEXT_PUBLIC_TELEGRAM_APP_NAME=

# Random secret for signing session cookies (min 32 chars)
SESSION_SECRET=change-me-to-a-long-random-string

# Allow browser login outside Telegram in development (1 = on)
DEV_AUTH_BYPASS=1
